<svg xmlns="http://www.w3.org/2000/svg" width="180.0mm" height="180.0mm" viewBox="-90.00 -90.00 180.00 180.00">
  <defs>
    <style>
      .bg { fill: #FFFFFF; }
      .boundary { stroke: #BDC3C7; stroke-width: 0.5; fill: none; stroke-dasharray: 2,2; }
      .rotor-edge { stroke: #2C3E50; stroke-width: 0.8; fill: none; }
      .center-hole { stroke: #E74C3C; stroke-width: 0.5; fill: none; }
      .grid-line { stroke: #E0E0E0; stroke-width: 0.35; fill: none; stroke-dasharray: 2,2; }
      .grid-text { font-family: sans-serif; font-size: 2.2px; fill: #7F8C8D; text-anchor: middle; }
      .sector-beat { fill: #2ECC71; fill-opacity: 0.18; stroke: #27AE60; stroke-width: 0.4; }
      .sector-gybe { fill: #E74C3C; fill-opacity: 0.18; stroke: #C0392B; stroke-width: 0.4; }
      .compass-tick { stroke: #2C3E50; stroke-width: 0.4; }
      .compass-text { font-family: sans-serif; font-weight: bold; font-size: 2.6px; fill: #2C3E50; text-anchor: middle; dominant-baseline: central; }
      .polar-curve { fill: none; stroke-width: 0.70; }
      .polar-label { font-family: sans-serif; font-weight: bold; font-size: 2.3px; dominant-baseline: central; }
      .awa-line { fill: none; stroke: #2980B9; stroke-width: 0.40; stroke-dasharray: 2.5,1.2; }
      .awa-label { font-family: sans-serif; font-size: 2.0px; fill: #1B4F72; text-anchor: middle; dominant-baseline: central; }
      .title-text { font-family: sans-serif; font-weight: bold; font-size: 2.8px; fill: #2C3E50; text-anchor: middle; }
      .sub-text { font-family: sans-serif; font-size: 1.8px; fill: #7F8C8D; text-anchor: middle; }
      .tack-label { font-family: sans-serif; font-weight: bold; font-size: 2.4px; fill: #27AE60; text-anchor: middle; }
      .gybe-label { font-family: sans-serif; font-weight: bold; font-size: 2.4px; fill: #C0392B; text-anchor: middle; }
      .vmg-beat { fill: #E74C3C; stroke: #962D22; stroke-width: 0.3; }
      .vmg-run { fill: #2ECC71; stroke: #27AE60; stroke-width: 0.3; }
      .crossover-marker { fill: #9B59B6; stroke: #8E44AD; stroke-width: 0.3; }
      .crossover-line { fill: none; stroke: #8E44AD; stroke-width: 0.55; stroke-dasharray: 1.8,1.2; }
      .crossover-text { font-family: sans-serif; font-weight: bold; font-size: 2.0px; fill: #8E44AD; }
    </style>
  </defs>
