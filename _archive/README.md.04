    "stator_core_wall_mm": 1.6,
    "front_rim_height_mm": 1.8,
    "back_rim_height_mm": 1.8,
    "front_rotor_disc_mm": 1.8,
    "back_rotor_disc_mm": 1.8,
    "pointer_arm_mm": 1.2
  },
