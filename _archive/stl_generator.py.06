#!/usr/bin/env python3
"""
stl_generator.py - Parametrischer Binär-STL-Generator für 180-mm-Sandwich-Kassette
Projekt: Nautische Rechenscheibe JPK 1080 (GER 7447 - TRUE GRIT)
Version: V1.20 (Parametrisch via config_manager.GEOM)

Erzeugt wasserdichte, druckbare Binär-STL-Dateien für den 3D-Druck (FDM / SLA):
1. gehaeuse_deckel_180mm.stl    - Oberer Statorring (Außen-Ø 180 mm, Sichtfenster-Ø 150 mm, 6x M3-Senkung)
2. gehaeuse_boden_180mm.stl     - Unterer Statorring mit ringförmiger Führungsnut (Ø 173 mm x 2.4 mm)
3. mittelscheibe_rotor_180mm.stl- Rotierende Scheibe (Ø 150 mm) mit Führungsfeder & 4 gerändelten Griff-Tabs
4. zentralzeiger_lineal.stl     - Zentraler Ablesezeiger Vorderseite (mit Radialkante und Indexspitze)
5. zentralzeiger_rueckseite.stl - Zentraler Ablesezeiger Rückseite (für C/D- und S-Skalen)
6. achspin_mittelbolzen.stl     - Zentraler Achsbolzen mit Spreiz-/Haltekopf
"""

import struct
import math
import numpy as np
from pathlib import Path
from typing import List, Tuple, Optional

# Parametrische Geometriedefinitionen aus dem zentralen Konfigurationsmanager
from config_manager import GEOM


def write_binary_stl(filepath: Path, triangles: np.ndarray, normals: Optional[np.ndarray] = None):
    """
    Schreibt ein Dreiecksnetz im standardisierten binären STL-Format.
    
    Format:
    - 80 Bytes ASCII/Binary Header
    - 4 Bytes Unsigned Integer (Anzahl Dreiecke)
    - Pro Dreieck 50 Bytes:
      - 3x 4 Bytes Float (Normalenvektor nx, ny, nz)
      - 3x 3x 4 Bytes Float (Knoten v0, v1, v2)
      - 2 Bytes Unsigned Integer (Attribute Byte Count = 0)
    """
    filepath = Path(filepath)
    filepath.parent.mkdir(parents=True, exist_ok=True)
    n_triangles = len(triangles)

    if normals is None or len(normals) != n_triangles:
        v0 = triangles[:, 0, :]
        v1 = triangles[:, 1, :]
        v2 = triangles[:, 2, :]
        cross = np.cross(v1 - v0, v2 - v0)
        norm = np.linalg.norm(cross, axis=1, keepdims=True)
        norm[norm == 0] = 1.0
        normals = (cross / norm).astype(np.float32)

    with open(filepath, "wb") as f:
        header = f"3D Printed Rechenscheibe 180mm - {filepath.stem}".encode("utf-8")
        header = header[:80].ljust(80, b"\0")
        f.write(header)
        f.write(struct.pack("<I", n_triangles))

        data = np.zeros(n_triangles, dtype=[
            ("normal", "<f4", (3,)),
            ("v0", "<f4", (3,)),
            ("v1", "<f4", (3,)),
            ("v2", "<f4", (3,)),
            ("attr", "<u2")
        ])
        data["normal"] = normals
        data["v0"] = triangles[:, 0, :]
        data["v1"] = triangles[:, 1, :]
        data["v2"] = triangles[:, 2, :]
        data["attr"] = 0
        data.tofile(f)


def _gen_annulus_mesh(
    r_inner: float,
    r_outer: float,
    z_bottom: float,
    z_top: float,
    segments: int = 144,
    center_xy: Tuple[float, float] = (0.0, 0.0)
) -> List[List[np.ndarray]]:
    """
    Erzeugt ein wasserdichtes Zylinder- oder Kreisring-Netz (Annulus) zwischen r_inner und r_outer.
    Ist r_inner == 0, wird ein voller Zylinder erzeugt.
    """
    triangles = []
    angles = np.linspace(0, 2 * np.pi, segments, endpoint=False)
    cx, cy = center_xy

    b_out = np.column_stack([cx + r_outer * np.cos(angles), cy + r_outer * np.sin(angles), np.full(segments, z_bottom)])
    t_out = np.column_stack([cx + r_outer * np.cos(angles), cy + r_outer * np.sin(angles), np.full(segments, z_top)])

    if r_inner > 0:
        b_in = np.column_stack([cx + r_inner * np.cos(angles), cy + r_inner * np.sin(angles), np.full(segments, z_bottom)])
        t_in = np.column_stack([cx + r_inner * np.cos(angles), cy + r_inner * np.sin(angles), np.full(segments, z_top)])
    else:
        b_center = np.array([cx, cy, z_bottom])
        t_center = np.array([cx, cy, z_top])

    for i in range(segments):
        next_i = (i + 1) % segments

        # Äußere Zylinderwand (Normale zeigt nach außen)
        triangles.append([b_out[i], t_out[i], t_out[next_i]])
        triangles.append([b_out[i], t_out[next_i], b_out[next_i]])

        if r_inner > 0:
            # Innere Zylinderwand (Bohrung, Normale zeigt nach innen zum Zentrum)
            triangles.append([b_in[i], t_in[next_i], t_in[i]])
            triangles.append([b_in[i], b_in[next_i], t_in[next_i]])

            # Obere Kreisringfläche (Z = z_top, Normale nach +Z)
            triangles.append([t_in[i], t_out[i], t_out[next_i]])
            triangles.append([t_in[i], t_out[next_i], b_in[next_i]]) if False else triangles.append([t_in[i], t_out[next_i], t_in[next_i]])

            # Untere Kreisringfläche (Z = z_bottom, Normale nach -Z)
            triangles.append([b_in[i], b_out[next_i], b_out[i]])
            triangles.append([b_in[i], b_in[next_i], b_out[next_i]])
        else:
            # Voller Zylinderdeckel (+Z)
            triangles.append([t_center, t_out[i], t_out[next_i]])
            # Voller Zylinderboden (-Z)
            triangles.append([b_center, b_out[next_i], b_out[i]])

    return triangles


def generate_deckel_stl(
    filepath: Path,
    r_outer: float = GEOM.stator_outer_radius,      # 90.0 mm -> Ø 180 mm
    r_inner: float = GEOM.stator_window_radius,    # 75.0 mm -> Ø 150 mm Fenster
    thickness: float = GEOM.stator_cover_thickness,# 2.2 mm
    pcd_screw: float = GEOM.screw_pcd_radius,      # 88.0 mm
    screw_r: float = (GEOM.screw_nominal_d / 2.0) + 0.2, # M3 Spielbohrung 1.7 mm
    segments: int = 180
):
    """
    Erzeugt den oberen Statorring (Gehäusedeckel).
    Enthält das zentrale Sichtfenster sowie 6 gleichmäßig verteilte M3-Bohrungen auf dem PCD.
    """
    triangles = []
    # Basis-Kreisring des Deckels
    triangles.extend(_gen_annulus_mesh(r_inner, r_outer, 0.0, thickness, segments))
    
    # 6x M3-Schraubensenkungs-Bohrungen
    for i in range(GEOM.screw_count):
        ang = math.radians(i * (360.0 / GEOM.screw_count))
        sx = pcd_screw * math.cos(ang)
        sy = pcd_screw * math.sin(ang)
        hole_tris = _gen_annulus_mesh(0.0, screw_r, 0.0, thickness, segments=24, center_xy=(sx, sy))
        triangles.extend(hole_tris)

    mesh = np.array(triangles, dtype=np.float32)
    write_binary_stl(filepath, mesh)


def generate_boden_stl(
    filepath: Path,
    r_outer: float = GEOM.stator_outer_radius,      # 90.0 mm
    r_inner: float = GEOM.stator_window_radius,    # 75.0 mm Sichtfenster
    r_groove: float = GEOM.screw_head_inner_limit, # 85.0 mm Nutkante (vor M3 Köpfen)
    base_thk: float = 2.0,                         # Bodenplatten-Dicke
    groove_depth: float = GEOM.rotor_thickness + GEOM.axial_clearance, # 2.4 mm Nut
    segments: int = 180
):
    """
    Erzeugt den unteren Statorring (Gehäuseboden mit ringförmiger Führungsnut).
    Die Führungsnut nimmt die umlaufende Feder der rotierenden Mittelscheibe auf.
    """
    triangles = []
    total_thk = base_thk + groove_depth

    # 1. Bodenplatten-Ring (vom Fenster r_inner bis Nutaußenkante r_groove)
    triangles.extend(_gen_annulus_mesh(r_inner, r_groove, 0.0, base_thk, segments))

    # 2. Äußerer Führungssteg / Randwand (von r_groove bis r_outer)
    triangles.extend(_gen_annulus_mesh(r_groove, r_outer, 0.0, total_thk, segments))

    mesh = np.array(triangles, dtype=np.float32)
    write_binary_stl(filepath, mesh)


def generate_rotor_stl(
    filepath: Path,
    r_window: float = GEOM.stator_window_radius,    # 75.0 mm
    r_tongue: float = GEOM.screw_head_inner_limit - GEOM.radial_clearance, # ~84.5 mm Führungsfeder
    r_tab: float = GEOM.thumb_tabs_outer_radius,    # 93.0 mm Griff-Tabs
    thickness: float = GEOM.rotor_thickness,        # 2.0 mm
    center_hole_r: float = GEOM.axle_hole_radius,   # 1.6 mm Achsbohrung
    segments: int = 180
):
    """
    Erzeugt die rotierende Mittelscheibe (Rotor) mit radialer Führungsfeder und
    4 ergonomisch platzierten Daumen-Grifflaschen (Tabs) bei 45°, 135°, 225°, 315°.
    """
    triangles = []

    # 1. Zentrale Drehscheibe inklusive Führungsfeder (vom Achsloch bis r_tongue)
    triangles.extend(_gen_annulus_mesh(center_hole_r, r_tongue, 0.0, thickness, segments))

    # 2. Vier Daumen-Bedienlaschen (extending from r_tongue to r_tab)
    tab_half_width_deg = GEOM.thumb_tabs_arc_deg / 2.0
    for center_deg in GEOM.thumb_tabs_angles:
        ang_start = math.radians(center_deg - tab_half_width_deg)
        ang_end = math.radians(center_deg + tab_half_width_deg)
        n_tab_pts = 24
        tab_angles = np.linspace(ang_start, ang_end, n_tab_pts)

        b_in = np.column_stack([r_tongue * np.cos(tab_angles), r_tongue * np.sin(tab_angles), np.zeros(n_tab_pts)])
        t_in = np.column_stack([r_tongue * np.cos(tab_angles), r_tongue * np.sin(tab_angles), np.full(n_tab_pts, thickness)])
        b_out = np.column_stack([r_tab * np.cos(tab_angles), r_tab * np.sin(tab_angles), np.zeros(n_tab_pts)])
        t_out = np.column_stack([r_tab * np.cos(tab_angles), r_tab * np.sin(tab_angles), np.full(n_tab_pts, thickness)])

        for i in range(n_tab_pts - 1):
            # Oberseite (+Z)
            triangles.append([t_in[i], t_out[i], t_out[i+1]])
            triangles.append([t_in[i], t_out[i+1], t_in[i+1]])
            # Unterseite (-Z)
            triangles.append([b_in[i], b_out[i+1], b_out[i]])
            triangles.append([b_in[i], b_in[i+1], b_out[i+1]])
            # Äußere gekrümmte Wand
            triangles.append([b_out[i], t_out[i], t_out[i+1]])
            triangles.append([b_out[i], t_out[i+1], b_out[i+1]])

        # Radiale Seitenflanken der Lasche
        triangles.append([b_in[0], t_in[0], t_out[0]])
        triangles.append([b_in[0], t_out[0], b_out[0]])
        triangles.append([b_in[-1], t_out[-1], t_in[-1]])
        triangles.append([b_in[-1], b_out[-1], t_out[-1]])

    mesh = np.array(triangles, dtype=np.float32)
    write_binary_stl(filepath, mesh)


def generate_pointer_stl(
    filepath: Path,
    length: float = GEOM.pointer_length_front,     # 85.0 mm (reicht exakt bis zur Stator-Kompassrose)
    width: float = 7.0,
    hub_radius: float = 5.0,
    center_hole_r: float = GEOM.axle_hole_radius, # 1.6 mm
    thickness: float = GEOM.pointer_thickness,    # 1.4 mm
    segments: int = 60
):
    """
    Erzeugt den transparenten Zentralzeiger (Läufer) mit präziser radialer Ablesekante (x=0)
    und spitzer Indexnase zur Übertragung von Peilwerten auf den Stator.
    """
    triangles = []

    # Naben-Ring um den zentralen Achsbolzen
    triangles.extend(_gen_annulus_mesh(center_hole_r, hub_radius, 0.0, thickness, segments))

    # 2D-Polygon des Zeigerkörpers entlang der +Y-Achse (Ablesekante liegt auf x = 0)
    tip_len = 5.0
    tab_len = 4.0
    y_body_end = length - tip_len - tab_len

    poly_2d = [
        (0.0, hub_radius * 0.8),
        (width, hub_radius * 0.8),
        (width, y_body_end),
        (width + 2.5, y_body_end + tab_len / 2.0), # Ergonomischer Daumen-Greifnocken
        (width, y_body_end + tab_len),
        (0.0, length)                              # Präzise Ablesespitze auf x=0
    ]

    n_pts = len(poly_2d)
    pts_b = np.array([[x, y, 0.0] for x, y in poly_2d], dtype=np.float32)
    pts_t = np.array([[x, y, thickness] for x, y in poly_2d], dtype=np.float32)

    for i in range(n_pts):
        next_i = (i + 1) % n_pts
        triangles.append([pts_b[i], pts_t[i], pts_t[next_i]])
        triangles.append([pts_b[i], pts_t[next_i], pts_b[next_i]])

    for i in range(1, n_pts - 1):
        triangles.append([pts_t[0], pts_t[i], pts_t[i + 1]])
        triangles.append([pts_b[0], pts_b[i + 1], pts_b[i]])

    mesh = np.array(triangles, dtype=np.float32)
    write_binary_stl(filepath, mesh)


def generate_achspin_stl(
    filepath: Path,
    shaft_radius: float = GEOM.axle_pin_nominal_radius, # 1.5 mm -> Ø 3.0 mm
    shaft_length: float = GEOM.axle_pin_total_length,   # 8.8 mm für Sandwich + 2 Zeiger
    head_radius: float = 4.5,
    head_thickness: float = 1.2,
    segments: int = 60
):
    """
    Erzeugt den zentralen Lagerbolzen mit flachem Haltekopf.
    """
    triangles = []
    # Zylindrischer Schaft
    triangles.extend(_gen_annulus_mesh(0.0, shaft_radius, 0.0, shaft_length, segments))
    # Flacher Haltekopf am Schaftende
    triangles.extend(_gen_annulus_mesh(0.0, head_radius, shaft_length, shaft_length + head_thickness, segments))

    mesh = np.array(triangles, dtype=np.float32)
    write_binary_stl(filepath, mesh)


def generate_all_stl_models(out_dir: Path) -> List[Path]:
    """
    Erzeugt alle 6 wasserdichten STL-Modelle für das Rechenscheiben-Sandwich V1.20.
    """
    out_dir = Path(out_dir)
    out_dir.mkdir(parents=True, exist_ok=True)

    files = {
        "gehaeuse_deckel_180mm.stl": lambda p: generate_deckel_stl(p),
        "gehaeuse_boden_180mm.stl": lambda p: generate_boden_stl(p),
        "mittelscheibe_rotor_180mm.stl": lambda p: generate_rotor_stl(p),
        "zentralzeiger_lineal.stl": lambda p: generate_pointer_stl(p, length=GEOM.pointer_length_front),
        "zentralzeiger_rueckseite.stl": lambda p: generate_pointer_stl(p, length=GEOM.pointer_length_back),
        "achspin_mittelbolzen.stl": lambda p: generate_achspin_stl(p, shaft_length=GEOM.axle_pin_total_length),
    }

    generated = []
    for fname, gen_func in files.items():
        fpath = out_dir / fname
        gen_func(fpath)
        generated.append(fpath)

    return generated


if __name__ == "__main__":
    out = Path("output/stl")
    res = generate_all_stl_models(out)
    print(f"Erfolgreich {len(res)} STL-Dateien generiert in {out.resolve()}")
