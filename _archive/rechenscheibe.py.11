#!/usr/bin/env python3
"""
rechenscheibe.py - Master Software Suite für die Nautische Rechenscheibe V3.0
Yacht: JPK 1080 (GER 7447 - TRUE GRIT)

Architektur V3.0:
- Parametrische Konfigurationsbasis (config.json, config_manager.py) mit mathematisch gekoppelten Abhängigkeiten.
- Single Source of Truth Vektor-Pipeline: CAM-SVGs sind die alleinige Referenzquelle;
  PNG-Vorschauen werden direkt via librsvg & libcairo gerendert (100% Identität).
- Vektorgeometrie auf Basis nativer komplexer Zahlen (cmath).
- 180 mm Sandwich-Kassette (Top Stator Ring, Bottom Stator Base, Rotating Disc, Central Pointer, Axle Pin).
- Seite A (Vorderseite): 1:1 ORC-Geschwindigkeitsdiagramm in absoluten Knoten (5.0 mm/kn, Ringe 2-12 kn).
  Rechts: TWA vs. Bootsspeed (0°..180°), Links: AWA vs. Bootsspeed (0°..180° wie im ORC Speed Guide).
  Symmetrische Rotor-Gradskala (0°..180° Steuerbord/Backbord) für Taktik-Rechner (TWD, Shift/Lift, Tack/Gybe, Start Line Bias).
  Zentralzeiger mit 1:1 Knotenskala.
- Seite B (Rückseite): Zirkularer Rechenschieber (C-Skala, D-Skala, exakt radiale S-Sinusskala R=65 mm mit 1/10° und 1/4° Teilung, Performance-Nonius, drehbarer Läufer).

Generiert:
1. Wasserdichte 3D-Druck-STL-Modelle (output/stl/)
2. Fertigungsgerechte Laser-/CAM-Vektorgrafiken SVG (output/svg/)
3. Hochauflösende 300-DPI-PNG-Vorschauen (output/previews/)
"""

import sys
import argparse
from pathlib import Path

from config_manager import CONFIG, GEOM
from polar_parser import PolarData
from stl_generator import generate_all_stl_models
from vector_engine import generate_all_laser_svgs
from preview_engine import render_all_previews


def format_file_size(filepath: Path) -> str:
    """Gibt die Dateigröße in lesbarem Format (KB / MB) zurück."""
    try:
        size = filepath.stat().st_size
        if size >= 1024 * 1024:
            return f"{size / (1024 * 1024):.1f} MB"
        elif size >= 1024:
            return f"{size / 1024:.1f} KB"
        else:
            return f"{size} B"
    except Exception:
        return "N/A"


def main():
    parser = argparse.ArgumentParser(
        description="Master Generator Suite: 180 mm Sandwich Rechenscheibe JPK 1080 (GER 7447 Edition V3.0)"
    )
    parser.add_argument(
        "--all",
        action="store_true",
        help="Generiert alles: 3D-STL-Modelle, 2D-Laser-SVGs und 300-DPI-Vorschauen (Standard)"
    )
    parser.add_argument(
        "--stl",
        action="store_true",
        help="Generiert 3D-druckbare, wasserdichte STL-Modelle nach output/stl/"
    )
    parser.add_argument(
        "--svg",
        action="store_true",
        help="Generiert Laser- und CAM-fähige Vektordateien (SVG) nach output/svg/"
    )
    parser.add_argument(
        "--preview",
        action="store_true",
        help="Rendert 300-DPI-Vorschauen direkt aus SVG nach output/previews/"
    )
    parser.add_argument(
        "--data",
        type=Path,
        default=Path(__file__).parent / "data" / "249116.slk",
        help="Pfad zur ORC-Polardatei (Standard: data/249116.slk)"
    )
    parser.add_argument(
        "--outdir",
        type=Path,
        default=Path(__file__).parent / "output",
        help="Haupt-Ausgabeverzeichnis (Standard: output)"
    )
    parser.add_argument(
        "--twa",
        type=float,
        default=40.0,
        help="Winkel des Zentralzeigers in der montierten Vorschau in Grad (Standard: 40.0°)"
    )
    parser.add_argument(
        "--dpi",
        type=int,
        default=300,
        help="Auflösung in DPI für die PNG-Vorschauen (Standard: 300)"
    )

    args = parser.parse_args()

    # Wenn keine spezifische Baugruppe gewählt wurde, standardmäßig alles bauen
    run_all = args.all or (not args.stl and not args.svg and not args.preview)
    run_stl = run_all or args.stl
    run_svg = run_all or args.svg
    run_preview = run_all or args.preview

    # Validierung der Polardaten-Datei
    polar_path = args.data
    if not polar_path.is_absolute():
        polar_path = Path(__file__).parent / polar_path

    if not polar_path.exists():
        print(f"[FEHLER] Polardatei nicht gefunden: {polar_path}")
        sys.exit(1)

    out_dir = args.outdir
    if not out_dir.is_absolute():
        out_dir = Path(__file__).parent / out_dir
    out_dir.mkdir(parents=True, exist_ok=True)

    print("=" * 76)
    print(" NAUTISCHE RECHENSCHEIBE V3.0 - JPK 1080 (GER 7447 - TRUE GRIT)")
    print(" 180 mm Sandwich-Kassette · 1:1 ORC Polaren (TWA/AWA) · Radiale S-Skala")
    print("=" * 76)
    print(f"[*] Polardaten:    {polar_path.name}")
    print(f"[*] Zielordner:    {out_dir}")
    print(f"[*] Rotorradius:   {GEOM.rotor_radius:.1f} mm (Ø {GEOM.rotor_radius*2:.1f} mm)")
    print(f"[*] Statorradius:  {GEOM.stator_outer_radius:.1f} mm (Ø {GEOM.stator_outer_radius*2:.1f} mm)")

    # 1. ORC-Polardaten laden
    print("\n[1/4] Lade und analysiere ORC-Polardaten...")
    polar = PolarData(polar_path)
    print(f"      -> {len(polar.tws_list)} Windstärken geladen: {', '.join(str(int(w)) + 'kt' for w in polar.tws_list)}")
    print(f"      -> VMG Targets: Upwind Beat {polar.vmg_targets[0]['beat_angle']:.1f}° bis {polar.vmg_targets[-1]['beat_angle']:.1f}°")
    print(f"      -> Segel-Polaren: {', '.join(polar.sail_polars.keys())}")

    # 2. STL 3D-Druck Modellerzeugung
    if run_stl:
        print("\n[2/4] Generiere wasserdichte 3D-Druck-Modelle (STL)...")
        stl_dir = out_dir / "stl"
        stl_files = generate_all_stl_models(stl_dir)
        for stl_path in stl_files:
            size_str = format_file_size(stl_path)
            print(f"      -> [OK] stl/{stl_path.name:<28} ({size_str})")

    # 3. SVG Laser- und CAM-Vektorgrafiken
    if run_svg:
        print("\n[3/4] Generiere fertigungsgerechte Laser-Vektordateien (SVG)...")
        svg_dir = out_dir / "svg"
        svg_files = generate_all_laser_svgs(polar, svg_dir)
        for svg_path in svg_files:
            size_str = format_file_size(svg_path)
            print(f"      -> [OK] svg/{svg_path.name:<32} ({size_str})")

    # 4. Hochauflösende 300 DPI Previews (Single Source of Truth via librsvg/cairo)
    if run_preview:
        print(f"\n[4/4] Rendere hochauflösende Vorschauen direkt aus SVG ({args.dpi} DPI)...")
        prev_dir = out_dir / "previews"
        prev_files = render_all_previews(polar, prev_dir, twa_pointer_deg=args.twa, dpi=args.dpi)
        for prev_path in prev_files:
            size_str = format_file_size(prev_path)
            print(f"      -> [OK] previews/{prev_path.name:<34} ({size_str})")

    print("\n" + "=" * 76)
    print(" [FERTIG] Release V3.0 erfolgreich generiert!")
    print(f" Speicherort: {out_dir}")
    print("=" * 76 + "\n")


if __name__ == "__main__":
    main()
