    },
    "shift_ticks_deg": [5.0, 10.0, 15.0],
    "bias_ticks_deg": [5.0, 10.0, 15.0],
    "awa_angles_deg": [25.0, 30.0, 35.0, 40.0, 45.0, 50.0, 60.0, 75.0, 90.0, 110.0, 135.0, 155.0]
  },
  "polar_settings": {
    "ratio_steps": 10,
    "curve_cutoff_twa_deg": 175.0,
    "curve_colors": [
      "#1F618D",
      "#2980B9",
      "#2471A3",
      "#17A589",
      "#138D75",
